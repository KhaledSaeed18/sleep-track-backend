# Copy to .env and adjust. Every variable is optional in development.

# --- application -----------------------------------------------------------
ENVIRONMENT=development            # development | test | staging | production
DEBUG=false
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000 # comma-separated
ALLOWED_HOSTS=*                    # enforced only in production, e.g. api.sleeptrack.app

# --- security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30          # remember-me sessions
REFRESH_SESSION_TTL_HOURS=24       # browser-session sign-ins
REFRESH_REUSE_GRACE_SECONDS=10
# COOKIE_SECURE=true               # defaults to true in staging/production
# COOKIE_DOMAIN=
MAX_REQUEST_BODY_BYTES=2097152

# --- features --------------------------------------------------------------
REGISTRATION_OPEN=true
EMAIL_VERIFICATION_REQUIRED=false
DEMO_MODE_ENABLED=true
DEMO_ACCOUNT_TTL_HOURS=24
RATE_LIMIT_ENABLED=true

# --- infrastructure --------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://sleeptrack:sleeptrack@localhost:5432/sleeptrack
REDIS_URL=redis://localhost:6379/0
JOBS_EAGER=false                   # run background jobs in-process (no worker)
ANALYTICS_CACHE_TTL_SECONDS=300

# --- email -----------------------------------------------------------------
EMAIL_PROVIDER=smtp                # console | smtp
EMAIL_FROM="SleepTrack <no-reply@sleeptrack.app>"
SMTP_HOST=localhost
SMTP_PORT=1025                     # Mailpit
# SMTP_USERNAME=
# SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_START_TLS=false

# --- Google OAuth (disabled unless both are set) ----------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Callback = ${OAUTH_REDIRECT_BASE_URL}/api/v1/auth/oauth/google/callback
# OAUTH_REDIRECT_BASE_URL=http://localhost:3000

# --- observability ---------------------------------------------------------
LOG_LEVEL=INFO
# LOG_FORMAT=console               # console | json (default: console in development)
METRICS_ENABLED=true
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
